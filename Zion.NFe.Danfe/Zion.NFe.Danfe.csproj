<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Authors>Alejandro Pietry</Authors>
    <Company>Econet Editora Empresarial</Company>
    <Description>Econet DacteDanfe é uma biblioteca em C# que permite a geração do DANFE e do DACTE em formato PDF. Com muitas possibilidades!
Feito em netstandard2.0 é multiplataforma.</Description>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Copyright>Copyright ©  2022</Copyright>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <PackageProjectUrl>https://www.nuget.org/packages/Econet.DanfeDacte</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AlejandroPietry/Econet.DanfeDacte</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <PackageTags>Danfe Nfe Dacte Dfe Cte </PackageTags>
    <PackageReleaseNotes></PackageReleaseNotes>
    <AssemblyVersion>2.1.0.1</AssemblyVersion>
    <FileVersion>2.1.0.1</FileVersion>
    <Version>2.1.0.1</Version>
    <ApplicationIcon />
    <OutputType>Library</OutputType>
    <StartupObject />
    <PackageId>Econet.DanfeDacte</PackageId>
    <Product>Econet.DanfeDacte</Product>
    <PackageIcon>document_paperclip_list_paper_icon_219514.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PdfSharpCore">
      <HintPath>$(USERPROFILE)\.nuget\packages\pdfsharpcore\1.3.67\lib\netstandard2.0\PdfSharpCore.dll</HintPath>
    </Reference>
    <Reference Include="SixLabors.Fonts">
      <HintPath>$(USERPROFILE)\.nuget\packages\sixlabors.fonts\1.0.0-beta17\lib\netstandard2.0\SixLabors.Fonts.dll</HintPath>
    </Reference>
    <Reference Include="SixLabors.ImageSharp">
      <HintPath>$(USERPROFILE)\.nuget\packages\sixlabors.imagesharp\1.0.4\lib\netstandard2.0\SixLabors.ImageSharp.dll</HintPath>
    </Reference>
    <Reference Include="ICSharpCode.SharpZipLib">
      <HintPath>$(USERPROFILE)\.nuget\packages\sharpziplib\1.4.2\lib\netstandard2.0\ICSharpCode.SharpZipLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="document_paperclip_list_paper_icon_219514.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
